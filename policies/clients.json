{
  "portal": {
    "token_env": "MG_PORTAL_TOKEN",
    "routes": [
      "portal-normal",
      "portal-light",
      "portal-workhorse"
    ],
    "paid_allowed": false,
    "monthly_budget_usd": 0,
    "requests_per_minute": 30,
    "monthly_request_limit": 10000,
    "allowed_capabilities": [
      "TEXT",
      "CODING",
      "REASONING",
      "TOOL_CALLING",
      "STRUCTURED_OUTPUT",
      "VISION",
      "LONG_CONTEXT",
      "PERSIAN",
      "DOCUMENT_ANALYSIS"
    ],
    "privacy_classes": [
      "PUBLIC",
      "INTERNAL"
    ],
    "default_privacy": "INTERNAL",
    "log_metadata": true,
    "log_content": false
  },
